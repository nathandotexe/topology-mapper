# Copy to .env and fill in. Loaded automatically by `topo-mapper`.
# These are the DEFAULT credentials; per-device overrides go in an inventory file.

TOPO_USERNAME=netadmin
TOPO_PASSWORD=changeme
# Enable/secret password, if your devices require it:
TOPO_SECRET=

# Netmiko device_type for seeds without an inventory override:
TOPO_DEVICE_TYPE=cisco_ios

# Optional: comma-separated seed IPs/hostnames (--seed overrides this):
TOPO_SEEDS=10.0.0.1
